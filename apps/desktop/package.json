{
  "name": "@solo/desktop",
  "version": "0.7.0",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "dist": "electron-vite build && electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "bonjour-service": "^1.4.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "selfsigned": "^5.5.0",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@solo/relay": "*",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "33.4.11",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.9"
  },
  "description": "Solo - personal AI companion for Windows",
  "author": {
    "name": "Solomon"
  },
  "homepage": "https://github.com/king401-hub/solo",
  "build": {
    "appId": "com.solo.desktop",
    "productName": "Solo",
    "artifactName": "Solo-Setup-${version}-x64.${ext}",
    "electronDist": "../../node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**",
      "package.json",
      "!**/onnxruntime-node/bin/napi-v6/darwin/**",
      "!**/onnxruntime-node/bin/napi-v6/linux/**",
      "!**/onnxruntime-node/bin/napi-v6/win32/arm64/**"
    ],
    "asarUnpack": [
      "**/onnxruntime-node/**",
      "**/sharp/**",
      "**/@img/**"
    ],
    "extraResources": [
      {
        "from": "resources/syncthing",
        "to": "syncthing"
      }
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
